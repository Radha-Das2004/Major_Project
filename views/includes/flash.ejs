<% if(success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show col-6 offset-3 mt-4" role="alert">
        <%= success %>
         <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div> 
<% } else if(update && update.length) { %>
    <div class="alert alert-info alert-dismissible fade show col-6 offset-3 mt-4" role="alert">
        <%= update %>
         <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div> 
 <% } else if(deleted && deleted.length) { %>
    <div class="alert alert-danger alert-dismissible fade show col-6 offset-3 mt-4" role="alert">
        <%= deleted %>
         <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div> 
 <% } else if(error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show col-6 offset-3 mt-4" role="alert">
        <%= error %>
         <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div> 
 <% } %>        
<% layout("/layouts/boilerplate")  %>

 <div class="row mt-3 justify-content-center">
        <div class="col-12 col-md-6 col-lg-5 px-4 px-md-0">
            <h2 class="text-center mb-4">SignUp on Wanderlust</h2> 
            <form method="post" action="/signup" novalidate class="needs-validation">
                <div class="mb-3" >
                    <label for="username" class="form-label">Username</label>
                    <input type="text" name="username"  class="form-control" required  />
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>
                <div class="mb-3 mt-4" >
                    <label for="email" class="form-label">Email</label>
                    <input type="email" name="email"  class="form-control" required  />
                </div>
                <div class="mb-3 mt-4" >
                    <label for="password" class="form-label">Password</label>
                    <input type="text" name="password"  class="form-control" required  />
                </div>
                <button  class="btn btn-outline-success w-100 mt-2">SignUp</button>
            </form>
        </div>
</div>
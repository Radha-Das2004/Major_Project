<% layout("/layouts/boilerplate")  %>
    <div class="row mt-4 pt-3 justify-content-center">
        <div class="col-12 col-md-8 mb-2 px-3">
                <h3 class="fw-bold"><%= listing.title %></h3>
        </div>
            <div class="card col-12 col-md-8 show-card listing-card border-0 px-3">
                <img src="<%=  listing.image.url %>" class="card-img-top show-image rounded-4" alt="<%= listing.image.filename %>" style="height: 22rem; object-fit: cover; width: 100%;">
                <div class="card-body px-1 py-3">
                    <p class="card-text mb-2">
                        <b>Owned by : <%= listing.owner ? listing.owner.username : "User" %></b>
                    </p>
                    <p class="card-text mb-2">
                        <b>Description :</b> <%= listing.description %>
                    </p>
                    <p class="card-text mb-2">
                        <b>Price :</b> &#8377 <%= listing.price.toLocaleString("en-IN") %>
                    </p>
                    <p class="card-text mb-2">
                        <b>Location :</b> <%= listing.location %>
                    </p>
                    <p class="card-text mb-2">
                        <b>Country :</b> <%= listing.country %>
                    </p>
                </div>
            </div>
           
            <% if(currUser && listing.owner &&  currUser._id.equals(listing.owner._id)) { %>
                <div class="btns col-12 col-md-8 d-flex gap-3 mb-4 px-3">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary px-4">Edit</a>
            
                    <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
                            <button class="btn btn-outline-danger px-4">Delete</button>
                    </form>
                </div>      
             <% } %>
           <div class="col-12 col-md-8 mb-3 px-3 mx-auto" >
                <% if(currUser) { %>
                    <hr/>
                    <h4>Leave & Review</h4>
                    <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
                       
                        <div class="mb-3 mt-3" >
                             <label for="rating" class="form-label">Rating</label>
                            <fieldset class="starability-slot ">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>
                        <div class="mb-3 mt-3">
                            <label for="comment">Comments</label>
                            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                            <div class="invalid-feedback">Please add some for reviews</div>
                        </div>
                        <button class="btn btn-outline-success">Submit</button>
                    </form>
                <% } %>
               

               <% if(listing.reviews.length > 0) { %>
                 <hr/>
                    <h4>Reviews</h4>
                <div class="row g-3">
                    <p><b>All Reviews</b></p>
                    <% for(let review of listing.reviews) {%>
                        <div class="col-12 col-md-6">
                            <div class="card h-100 p-3 shadow-sm border rounded-3">
                                <div class="card-body p-0">
                                <h5 class="card-title fw-bold">@<%= review.author ? review.author.username : "Anonymous" %></h5>
                                <p class="card-text text-muted mb-3"><%= review.comment %></p>
                                
                                <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
                                <% if(currUser && review.author &&  currUser._id.equals(review.author._id)) { %>
                                    <form method="post" class="mb-3" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="m-0">
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
                <% } %>
           </div>
           
           <div class="col-12 col-md-8 mb-5 px-3 mx-auto">
                <!-- Map Section -->
                <div>
                    <h3>Where you'll be</h3>
                    <div id="map" class="map-container rounded-4 shadow-sm" style="height: 350px; width: 100%;" ></div>
                </div>
        </div>
    </div>

    <!-- 1. Listing Data ko window variables me save karein (EJS execution yahan hogi) -->
<script>
        const coordinates = JSON.parse('<%- JSON.stringify(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length ? listing.geometry.coordinates : [77.2090, 28.6139]) %>');
            const listingTitle = "<%= listing.title %>";
</script>

<!-- 2. Apni external map.js file link karein -->
<script src="/javascript/map.js"></script>